{
  "name": "@amazon-connect/sdk",
  "version": "1.0.14",
  "description": "",
  "scripts": {
    "build": "nx run-many -t build:cjs build:esm --parallel=8 --nxBail=true --output-style=stream",
    "cache-reset": "nx reset",
    "check-types": "nx run-many -t check-types --parallel=8 --nxBail=true --output-style=stream",
    "clean": "rm -rf ./build .nx && nx run-many -t clean --parallel=8 --output-style=stream",
    "format": "nx run-many -t format --parallel=8 --output-style=stream",
    "graph": "nx graph",
    "lint": "nx run-many -t lint --parallel=8 --nxBail=true --output-style=stream",
    "prepare": "husky",
    "prepublishOnly": "npm run lint",
    "release": "npm run build && npm run test && npm run test-report",
    "test": "nx run-many -t test --parallel=8 --nxBail=true --output-style=stream",
    "test-report": "node test-report.js",
    "prepack": "nx run-many -t prepack --parallel=8 --nxBail=true --output-style=stream"
  },
  "devDependencies": {
    "@swc/cli": "0.8.0",
    "@swc/core": "1.11.29",
    "@swc/jest": "0.2.38",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "baseline-browser-mapping": "2.9.4",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "husky": "9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jest": "30.2.0",
    "jest-mock-extended": "4.0.0",
    "lint-staged": "16.2.7",
    "nx": "20.8.0",
    "prettier": "3.7.3",
    "ts-loader": "9.5.4",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@swc/core-darwin-arm64": "1.11.29",
    "@swc/core-linux-x64-gnu": "1.11.29"
  },
  "workspaces": [
    "core",
    "workspace-types",
    "app",
    "site",
    "site-streams",
    "app-controller",
    "contact",
    "voice",
    "file",
    "email",
    "theme",
    "user",
    "message-template",
    "quick-responses",
    "activity",
    "app-manager",
    "app-manager-agent",
    "ai-agents",
    "extensibility",
    "contact-ui"
  ]
}
